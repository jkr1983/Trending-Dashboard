# ─── YouTube ──────────────────────────────────────────────────────────────────
# Required. Get from: https://console.cloud.google.com → YouTube Data API v3
# Quota note: the 24h trending fetch uses ~200 units per refresh (~9,600/day at
# 30-min intervals) due to the extra search.list pass. Still well within the
# free 10,000-unit daily quota.
YOUTUBE_API_KEY=your_youtube_api_key_here

# ─── Hacker News ──────────────────────────────────────────────────────────────
# No API key required. Uses the official Firebase HN API (free, public).

# ─── GitHub Trending ──────────────────────────────────────────────────────────
# No API key required. Scrapes the public github.com/trending page.

# ─── Dev.to ───────────────────────────────────────────────────────────────────
# No API key required. Uses the public Dev.to API v1 (free, unauthenticated).

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
